# Copiar a .env.local (local) o cargar en Vercel -> Settings -> Environment Variables.

# --- Meta for Developers -> tu app -> Configuracion basica
META_APP_ID=
META_APP_SECRET=
# Tiene que coincidir EXACTO con "Valid OAuth Redirect URIs" en la app de Meta
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_SCOPES=ads_management,ads_read,business_management
# Token con el que el panel lee Meta. Se renueva desde la pestana
# Conexiones (boton "Renovar token de Meta" -> /api/auth/meta).
META_ACCESS_TOKEN=

# --- Renovacion en un click (opcional). Con VERCEL_API_TOKEN, el callback de
# Meta guarda META_ACCESS_TOKEN en Vercel y redeploya solo. Sin esto, la
# pagina de callback muestra el token para copiarlo a mano.
# Token de vercel.com/account/tokens con alcance al equipo del proyecto.
VERCEL_API_TOKEN=
# Por defecto: equipo tout2, proyecto botl-g1m-dashboard
VERCEL_TEAM=
VERCEL_PROJECT=
# Opcional: si se carga un Deploy Hook, se usa para redeployar
VERCEL_DEPLOY_HOOK_URL=

# --- Acceso al panel (una sola contrasena)
DASHBOARD_PASSWORD=
# Opcional: secreto para firmar sesiones (si no, se deriva de la contrasena)
SESSION_SECRET=

APP_URL=http://localhost:3000
