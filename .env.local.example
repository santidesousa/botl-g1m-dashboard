# Copiar a .env.local (local) o cargar en Vercel -> Settings -> Environment Variables.

# --- Meta for Developers -> tu app -> Configuracion basica
META_APP_ID=
META_APP_SECRET=
# Tiene que coincidir EXACTO con "Valid OAuth Redirect URIs" en la app de Meta
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
META_SCOPES=ads_management,ads_read,business_management
# Token con el que el panel lee Meta. Se obtiene UNA vez entrando a
# /api/auth/meta (la pagina de callback lo muestra para copiarlo).
META_ACCESS_TOKEN=

# --- Acceso al panel (una sola contrasena)
DASHBOARD_PASSWORD=
# Opcional: secreto para firmar sesiones (si no, se deriva de la contrasena)
SESSION_SECRET=

APP_URL=http://localhost:3000
